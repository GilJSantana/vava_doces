# Google OAuth2 Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# See docs/OAUTH2_SETUP_GUIDE.md for complete setup instructions
OAUTH2_CLIENT_ID = "YOUR_OAUTH2_CLIENT_ID.apps.googleusercontent.com"
OAUTH2_CLIENT_SECRET = "YOUR_OAUTH2_CLIENT_SECRET"
OAUTH2_REDIRECT_URI = "http://localhost:8501"
# Service Account for Drive Permission Checks
# This should point to the service account JSON file
SERVICE_ACCOUNT_FILE = "credencial/vava-doces-0667d5821bd5.json"
# Google Drive Source Folder ID
# The ID of the folder that users need access to
# Extract from: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID = "YOUR_DRIVE_FOLDER_ID"
# Google Sheets Configuration (existing settings)
GOOGLE_SHEET_ID = "1KEzf8FcL21DMk_64t-B9gMQIxjEx3ZPS_XsY-jYNVNk"
GOOGLE_APPLICATION_CREDENTIALS = "credencial/vava-doces-0667d5821bd5.json"
# Optional: Environment Settings
VAVA_SHEETS_CACHE_TTL = "300"
VAVA_PERF_LOG = "false"
VAVA_SALES_SOURCE = "gold"
